{
  "buildCommand": "node tools/build-pages.mjs",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/listen",
      "destination": "/listen/",
      "statusCode": 308
    },
    {
      "source": "/francespoon",
      "destination": "/studio/",
      "statusCode": 307
    },
    {
      "source": "/francespoon/(.*)",
      "destination": "/studio/",
      "statusCode": 307
    }
  ],
  "headers": [
    {
      "source": "/listen/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/free/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/listen-preview/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
